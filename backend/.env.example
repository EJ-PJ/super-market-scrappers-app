# On the VPS: cp .env.example .env and fill it in (never commit it)

# Flask secret key: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_KEY=

# Frontend origins allowed by CORS, comma separated (your Vercel domain)
CORS_ORIGINS=https://your-app.vercel.app

# Folder with the Let's Encrypt certificates (default: the inventario certbot)
# CERTS_DIR=/opt/inventario/certbot/conf
