# Copy to .env.production on the VPS and fill it in (never commit it)

# Flask secret key: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_KEY=

# Domain of the API pointing (A record) to the VPS IP.
# Without a domain you can use sslip.io: api.<ip-with-dashes>.sslip.io, e.g. api.203-0-113-10.sslip.io
API_DOMAIN=super.elbuenclavo.tech

# Email for Let's Encrypt (certificate expiry notices)
ACME_EMAIL=

# Frontend origins allowed by CORS, comma separated (your Vercel domain)
CORS_ORIGINS=https://your-app.vercel.app
